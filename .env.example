# Compte surveille — deja rempli.
X_HANDLES=astronomer_zero

# Telegram — bot deja cree et teste : @astro_short_watcher_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ══ TOUT GRATUIT — rien a payer, rien a creer ═════════════

# Source des tweets : telegram | twitterapi | apify
#   telegram   : lit sa chaine publique t.me/AstronomerZero, qui relaie ses
#                tweets avec le texte et l'image. Aucune cle, aucun quota.
#   twitterapi : payant (~9 $/mois), texte complet et non tronque.
#   apify      : NE MARCHE PAS sur le plan gratuit (pas de proxy residentiel,
#                X bloque les IP datacenter). Teste le 12/09/2026.
SOURCE_X=telegram
TELEGRAM_CANAL=AstronomerZero

# Quelle IA lit les messages : gemini | anthropic
FOURNISSEUR_IA=gemini

# Gemini — gratuit, teste et fonctionnel. https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ══ OPTIONS PAYANTES (inactives) ══════════════════════════

# twitterapi.io — https://twitterapi.io
TWITTERAPI_IO_KEY=

# Apify — https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Anthropic — https://console.anthropic.com/settings/keys
# Facturation separee de ton abonnement Claude, qui ne couvre pas l'API.
ANTHROPIC_API_KEY=


# ══ Reglages optionnels (defauts en commentaire) ══════════
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_MODEL=claude-opus-5
# APIFY_MAX=5
# APIFY_ACTEUR=xtdata~twitter-x-user-tweets-scraper
# IGNORER_REPONSES=true
# IGNORER_RETWEETS=true
# ALERTER_SANS_TRADE=false
# ANALYSER_SANS_IMAGE=true
# SILENCE_PREMIER_RUN=true
